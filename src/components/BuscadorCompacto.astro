---
import { CONSULTA_MINIMA } from '../lib/openlibrary';
import { PARAM_CIUDAD, ciudadElegida } from '../lib/ubicacion';

interface Props {
	valor?: string;
}

const { valor = '' } = Astro.props;
const elegida = ciudadElegida(Astro.url);
---

<form class="compacto" action="/buscar" method="get" role="search" transition:persist="buscador">
	<label class="visualmente-oculto" for="q-barra">Título, autor o ISBN</label>
	<input id="q-barra" name="q" type="search" required minlength={CONSULTA_MINIMA} value={valor} placeholder="Título, autor o ISBN" />
	{/* Deshabilitado no se envía: así la búsqueda solo lleva la ciudad cuando el usuario eligió una. */}
	<input id="ciudad-barra" type="hidden" name={PARAM_CIUDAD} value={elegida?.id ?? ''} disabled={!elegida} />
	<button type="submit">Buscar</button>
</form>

<script>
	document.addEventListener('astro:before-swap', (evento) => {
		// La barra persiste entre páginas, así que el texto se toma de la página nueva (importa al ir hacia atrás).
		const actual = document.querySelector<HTMLInputElement>('#q-barra');
		const nuevo = evento.newDocument.querySelector<HTMLInputElement>('#q-barra');
		if (actual && nuevo) actual.value = nuevo.value;
		const ciudadActual = document.querySelector<HTMLInputElement>('#ciudad-barra');
		const ciudadNueva = evento.newDocument.querySelector<HTMLInputElement>('#ciudad-barra');
		if (ciudadActual && ciudadNueva) {
			ciudadActual.value = ciudadNueva.value;
			ciudadActual.disabled = ciudadNueva.disabled;
		}

		// Buscar otra vez desde los resultados no es cambiar de página: se reemplaza el contenido sin animar.
		if (evento.from.pathname === '/buscar' && evento.to.pathname === '/buscar') {
			evento.viewTransition.skipTransition();
		}
	});
</script>

<style>
	.compacto {
		display: flex;
		max-width: 32rem;
		border-bottom: 2px solid var(--tinta-suave);
	}

	.compacto:focus-within {
		border-bottom-color: var(--rosa);
	}

	input {
		flex: 1;
		min-width: 0;
		min-height: 2.5rem;
		padding: 0.2rem 0;
		border: 0;
		background: transparent;
		color: var(--tinta);
		font: 700 var(--paso-1) var(--font-libro);
	}

	input:focus-visible {
		outline: none;
	}

	button {
		padding: 0 0.25rem 0 0.75rem;
		border: 0;
		background: none;
		color: var(--rosa-texto);
		font: 700 var(--paso-0) var(--font-ui);
		cursor: pointer;
	}
</style>
