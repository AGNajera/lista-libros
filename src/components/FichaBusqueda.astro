---
import { PARAM_CIUDAD, ciudadElegida, nombreCompleto, nombreCorto, obtenerUbicacion } from '../lib/ubicacion';

/** El buscador grande de la portada, dibujado como una ficha catalográfica. */
const { ciudad } = obtenerUbicacion(Astro.url, Astro.request.headers);
const elegida = ciudadElegida(Astro.url);

/** Títulos que se van escribiendo en el campo vacío, como ejemplos de qué buscar. */
const ejemplos = [
	'Pedro Páramo',
	'Cien años de soledad',
	'Como agua para chocolate',
	'Las batallas en el desierto',
	'El laberinto de la soledad',
	'Temporada de huracanes',
	'Rayuela',
];
---

<form class="ficha papel contorno-mano" action="/buscar" method="get" role="search">
	<p class="margen" aria-hidden="true">
		<span>Para</span>
		{nombreCorto(ciudad)}
	</p>
	{elegida && <input type="hidden" name={PARAM_CIUDAD} value={elegida.id} />}
	<label class="encabezado" for="q">Título, autor o ISBN</label>
	<div class="renglon-entrada">
		<div class="campo">
			{/* El placeholder va en blanco: solo sirve para que :placeholder-shown diga si el campo está vacío. */}
			<input id="q" name="q" type="search" required minlength="2" autocomplete="off" placeholder=" " />
			<span class="ejemplo" aria-hidden="true" data-ejemplos={JSON.stringify(ejemplos)}>{ejemplos[0]}</span>
		</div>
	</div>
	<p class="renglon nota">
		Buscamos primero ediciones en español y te avisamos si el libro solo está en otro idioma.
	</p>
	<p class="renglon nota">Las tiendas físicas se buscan cerca de {nombreCompleto(ciudad)}.</p>
	<div class="renglon acciones">
		<button class="boton" type="submit">Buscar libro</button>
	</div>
</form>

<script>
	const pausa = (ms: number) => new Promise((listo) => setTimeout(listo, ms));

	/** Borra el ejemplo letra por letra y escribe el siguiente, mientras la ficha siga en la página. */
	async function rotarEjemplos(ejemplo: HTMLElement) {
		const titulos: string[] = JSON.parse(ejemplo.dataset.ejemplos ?? '[]');
		let indice = 0;
		while (titulos.length > 1) {
			await pausa(2600);
			for (let n = titulos[indice].length - 1; n >= 0; n--) {
				ejemplo.textContent = titulos[indice].slice(0, n);
				await pausa(28);
			}
			await pausa(350);
			if (!ejemplo.isConnected) return;
			indice = (indice + 1) % titulos.length;
			for (let n = 1; n <= titulos[indice].length; n++) {
				ejemplo.textContent = titulos[indice].slice(0, n);
				await pausa(60);
			}
		}
	}

	document.addEventListener('astro:page-load', () => {
		const ejemplo = document.querySelector<HTMLElement>('.ficha .ejemplo');
		if (!ejemplo || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		rotarEjemplos(ejemplo);
	});

	document.addEventListener('astro:before-swap', (evento) => {
		// Buscar desde la ficha cambia de página sin animar; de la portada a /buscar solo se llega por ella.
		if (evento.from.pathname === '/' && evento.to.pathname === '/buscar') {
			evento.viewTransition.skipTransition();
		}
	});
</script>

<style>
	.ficha {
		--alto: var(--renglon-alto);
		position: relative;
		display: grid;
		--margen-ficha: 6.25rem;
		grid-template-columns: var(--margen-ficha) 1fr;
		max-width: 46rem;
		padding: 1.25rem 1.5rem 3.25rem 0;
		border-radius: 0.3rem;
		/* Renglones azules a partir del encabezado; el primero, rosa y doble, como en las fichas reales. */
		background-image:
			linear-gradient(to right, transparent calc(var(--margen-ficha) - 2px), var(--rosa) calc(var(--margen-ficha) - 2px), var(--rosa) var(--margen-ficha), transparent var(--margen-ficha)),
			repeating-linear-gradient(to bottom, transparent 0, transparent calc(var(--alto) * 2 - 1px), var(--renglon) calc(var(--alto) * 2 - 1px), var(--renglon) calc(var(--alto) * 2));
		background-position: 0 0, 0 4.5rem;
		background-size: auto, 100% calc(var(--alto) * 2);
		background-repeat: no-repeat, repeat;
	}

	/* El orificio de la varilla del fichero. */
	.ficha::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: 0.9rem;
		width: 1.4rem;
		height: 1.4rem;
		translate: -50% 0;
		border-radius: 50%;
		background: var(--mesa);
		box-shadow: inset 0 2px 4px var(--sombra);
	}

	.margen {
		grid-row: 1 / span 5;
		padding: 0.15rem 0.5rem 0 0.75rem;
		font: 700 var(--paso--1) / 1.25 var(--font-libro);
		color: var(--tinta-suave);
		hyphens: auto;
	}

	.margen span {
		display: block;
		font-weight: 400;
		font-style: italic;
	}

	.encabezado {
		grid-column: 2;
		display: block;
		padding: 0 0 0.6rem 1.25rem;
		border-bottom: 3px double var(--rosa);
		font: italic 400 var(--paso-1) / 1.3 var(--font-libro);
		color: var(--tinta-suave);
	}

	.renglon-entrada,
	.renglon {
		grid-column: 2;
		padding-left: 1.25rem;
	}

	.renglon-entrada {
		padding-top: 0.9rem;
	}

	input {
		width: 100%;
		padding: 0.2rem 0 0.3rem;
		border: 0;
		border-bottom: 2px solid var(--tinta-suave);
		border-radius: 0;
		background: transparent;
		color: var(--tinta);
		font: 700 var(--paso-3) / 1.15 var(--font-libro);
		appearance: none;
	}

	.campo {
		position: relative;
	}

	/* El ejemplo se dibuja encima del campo vacío y deja pasar los clics. */
	.ejemplo {
		position: absolute;
		inset: 0;
		padding: 0.2rem 0 0.3rem;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		color: var(--tinta-tenue);
		font: italic 400 var(--paso-3) / 1.15 var(--font-libro);
		pointer-events: none;
	}

	input:not(:placeholder-shown) + .ejemplo {
		display: none;
	}

	input:focus-visible {
		outline: none;
		border-bottom-color: var(--rosa);
		box-shadow: 0 2px 0 var(--rosa);
	}

	.nota {
		max-width: 52ch;
		padding-top: 0.75rem;
		color: var(--tinta-suave);
		font-size: var(--paso--1);
	}

	.acciones {
		padding-top: 1.25rem;
	}

	@media (max-width: 34rem) {
		.ficha {
			--margen-ficha: 0.9rem;
			padding-right: 1rem;
		}

		.margen {
			display: none;
		}

		.encabezado,
		.renglon-entrada,
		.renglon {
			padding-left: 1rem;
		}

		.acciones .boton {
			width: 100%;
		}
	}
</style>
