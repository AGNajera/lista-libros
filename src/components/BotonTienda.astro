---
import type { Tienda } from '../lib/tiendas';

interface Props {
	tienda: Tienda;
	href: string;
	ebook?: boolean;
}

const { tienda, href, ebook = false } = Astro.props;
const colores = (ebook && tienda.ebook?.marca) || tienda.marca;
const texto = ebook ? `eBook en ${tienda.nombreCorto}` : `Ver en ${tienda.nombreCorto}`;
---

{/* Cada botón usa los colores e ícono de la tienda para reconocerla de un vistazo. */}
<a
	class="boton-tienda"
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	style={`--fondo: ${colores.fondo}; --texto: ${colores.texto}; --hover: ${colores.hover}`}
>
	<img
		class:list={['icono', { placa: tienda.marca.placa }]}
		src={tienda.marca.icono}
		alt=""
		width="22"
		height="22"
		loading="lazy"
		decoding="async"
	/>
	<span>{texto}</span>
	<span class="visualmente-oculto"> (abre otra pestaña)</span>
</a>

<style>
	.boton-tienda {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		min-height: 2.75rem;
		padding: 0.4rem 1.05rem 0.4rem 0.7rem;
		border-radius: 0.55rem;
		background: var(--fondo);
		color: var(--texto);
		font: 700 var(--paso-0) / 1 var(--font-ui);
		text-decoration: none;
		white-space: nowrap;
		box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.18);
	}

	.boton-tienda:hover {
		background: var(--hover);
		color: var(--texto);
	}

	.icono {
		flex: none;
		width: 22px;
		height: 22px;
		object-fit: contain;
	}

	/* Los favicons se muestran como placa blanca, igual que en la pestaña del navegador. */
	.placa {
		border-radius: 5px;
		background: #ffffff;
		box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.85);
	}
</style>
