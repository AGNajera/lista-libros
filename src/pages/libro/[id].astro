---
import BotonTienda from '../../components/BotonTienda.astro';
import BuscadorCompacto from '../../components/BuscadorCompacto.astro';
import Portada from '../../components/Portada.astro';
import SelloIdioma from '../../components/SelloIdioma.astro';
import Layout from '../../layouts/Layout.astro';
import { ESPANOL, avisoIdioma, nombreIdioma } from '../../lib/idiomas';
import { obtenerLibro, type DetalleLibro } from '../../lib/openlibrary';
import { pareceIngles } from '../../lib/sinopsis';
import {
	TIENDAS,
	TIENDAS_EBOOK,
	TIENDAS_IMPRESO,
	consultaParaTiendas,
	esDeSuCatalogo,
	primeroSuCatalogo,
	tituloParaTiendas,
	urlEbook,
	urlSucursales,
} from '../../lib/tiendas';
import { conCiudad, nombreCompleto, obtenerUbicacion } from '../../lib/ubicacion';

const obraId = Astro.params.id ?? '';
const edicionId = Astro.url.searchParams.get('ed') ?? undefined;
const consulta = Astro.url.searchParams.get('q') ?? '';

let libro: DetalleLibro | null = null;
let fallo = false;
try {
	libro = await obtenerLibro(obraId, edicionId);
	if (!libro) Astro.response.status = 404;
} catch (error) {
	console.error('Detalle fallido', error);
	fallo = true;
	Astro.response.status = 502;
}

const { ciudad, origen } = obtenerUbicacion(Astro.url, Astro.request.headers);
const lugar = nombreCompleto(ciudad);
const tituloTiendas = libro ? tituloParaTiendas(libro) : '';
const consultaTiendas = libro ? consultaParaTiendas(libro) : '';
// Las tiendas que buscan sin el autor, para aclararlo en la nota cuando su consulta es distinta.
const soloTitulo =
	consultaTiendas !== tituloTiendas
		? new Intl.ListFormat('es').format(TIENDAS.filter((tienda) => tienda.soloTitulo).map((tienda) => tienda.nombreCorto))
		: '';

const impresos = libro ? primeroSuCatalogo(TIENDAS_IMPRESO, libro.editorial) : [];
// Las tiendas sin buscador web solo aparecen si encontraron el libro.
const ebooks = libro
	? (
			await Promise.all(
				primeroSuCatalogo(TIENDAS_EBOOK, libro.editorial).map(async (tienda) => ({
					tienda,
					href: await urlEbook(tienda, consultaParaTiendas(libro, tienda)),
				})),
			)
		).filter((ebook): ebook is typeof ebook & { href: string } => Boolean(ebook.href))
	: [];

const sinopsisEnIngles = libro?.sinopsisOriginal ? pareceIngles(libro.sinopsisOriginal.join(' ')) : false;
const volver = conCiudad(consulta ? `/buscar?${new URLSearchParams({ q: consulta })}` : '/', Astro.url);
const enlaceEspanol =
	libro?.edicionEspanol &&
	conCiudad(
		`/libro/${libro.obraId}?${new URLSearchParams({ ed: libro.edicionEspanol.edicionId!, ...(consulta && { q: consulta }) })}`,
		Astro.url,
	);

const datos = libro
	? ([
			['Autor', libro.autores.join(', ')],
			['Editorial', libro.editorial],
			['Año', libro.anio],
			['Páginas', libro.paginas],
			['Idioma', nombreIdioma(libro.idioma) ?? 'Sin confirmar'],
		].filter(([, valor]) => valor) as [string, string | number][])
	: [];
---

<Layout titulo={libro?.titulo ?? 'Libro no encontrado'}>
	<BuscadorCompacto slot="barra" valor={consulta} />

	<a class="volver" href={volver}>{consulta ? `Volver a «${consulta}»` : 'Volver al inicio'}</a>

	{
		fallo && (
			<p class="aviso" role="alert">
				El catálogo de Open Library no respondió. Espera unos segundos y <a href={Astro.url.pathname + Astro.url.search}>vuelve a intentarlo</a>.
			</p>
		)
	}

	{
		!fallo && !libro && (
			<div class="vacio">
				<h1>No encontramos este libro</h1>
				<p>El enlace puede estar incompleto. Busca el título de nuevo desde la barra de arriba.</p>
			</div>
		)
	}

	{
		libro && (
			<article class="libro">
				<div class="cabecera">
					<Portada obraId={libro.obraId} portadaId={libro.portadaId} titulo={libro.titulo} tamano="L" carga="eager" />

					<div class="ficha-libro">
						<h1 transition:name={`titulo-${libro.obraId}`}>{libro.titulo}</h1>
						{libro.subtitulo && <p class="subtitulo">{libro.subtitulo}</p>}
						{libro.autores.length > 0 && <p class="autor">{libro.autores.join(', ')}</p>}
						<SelloIdioma idioma={libro.idioma} grande />

						{libro.idioma !== ESPANOL && (
							<p class="aviso" role="note">
								{avisoIdioma(libro.idioma)}{' '}
								{enlaceEspanol ? (
									<>
										Hay {libro.totalEdicionesEspanol === 1 ? 'una edición' : `${libro.totalEdicionesEspanol} ediciones`} en
										español: <a href={enlaceEspanol}>ver «{libro.edicionEspanol!.titulo}»</a>.
									</>
								) : (
									'No encontramos una edición en español en el catálogo; las tiendas pueden tener traducciones recientes.'
								)}
							</p>
						)}

						<dl class="datos">
							{datos.map(([nombre, valor]) => (
								<div>
									<dt>{nombre}</dt>
									<dd>{valor}</dd>
								</div>
							))}
						</dl>
					</div>
				</div>

				<section class="sinopsis" aria-labelledby="titulo-sinopsis">
					<h2 id="titulo-sinopsis">Sinopsis</h2>
					{libro.sinopsis ? (
						<>
							<div class="texto">
								{libro.sinopsis.parrafos.map((parrafo) => (
									<p>{parrafo}</p>
								))}
							</div>
							{libro.sinopsis.fuente === 'wikipedia' && (
								<p class="nota">
									Resumen de{' '}
									<a href={libro.sinopsis.url} target="_blank" rel="noopener noreferrer">
										Wikipedia en español
									</a>
									.
								</p>
							)}
						</>
					) : libro.sinopsisOriginal ? (
						<>
							<p class="aviso" role="note">
								No encontramos una sinopsis en español para este libro. Te mostramos la que hay en{' '}
								{sinopsisEnIngles ? 'inglés' : 'otro idioma'}.
							</p>
							<div class="texto" lang={sinopsisEnIngles ? 'en' : undefined}>
								{libro.sinopsisOriginal.map((parrafo) => (
									<p>{parrafo}</p>
								))}
							</div>
						</>
					) : (
						<p class="nota">Este libro todavía no tiene sinopsis en el catálogo, ni en español ni en otro idioma.</p>
					)}
				</section>

				<section class="compra" aria-labelledby="titulo-compra">
					<div class="compra-encabezado">
						<h2 id="titulo-compra">Dónde comprarlo</h2>
						<p class="nota">
							Buscamos «{consultaTiendas}» en cada tienda{soloTitulo && ` (en ${soloTitulo}, solo «${tituloTiendas}»)`}; ahí
							verás precio, existencias y otras ediciones.
						</p>
					</div>

					<section class="formato" aria-labelledby="titulo-impreso">
						<div class="formato-encabezado">
							<h3 id="titulo-impreso">Libro físico</h3>
							<p>
								Sucursales cerca de <strong>{lugar}</strong>.{' '}
								{origen === 'predeterminada' ? (
									<a href="#ciudad">Elige tu ciudad</a>
								) : (
									<a href="#ciudad">Cambiar ciudad</a>
								)}
							</p>
						</div>

						<ul class="tiendas papel contorno-mano">
							{impresos.map((tienda) => {
								const sucursales = urlSucursales(tienda, ciudad);
								const deSuCatalogo = esDeSuCatalogo(tienda, libro.editorial);
								return (
									<li class:list={['tienda', { destacada: deSuCatalogo }]}>
										<div class="tienda-nombre">
											<h4>{tienda.nombre}</h4>
											{deSuCatalogo && <p class="catalogo">{libro.editorial} es de su grupo editorial</p>}
										</div>
										<div class="tienda-acciones">
											<BotonTienda tienda={tienda} href={tienda.buscar(consultaParaTiendas(libro, tienda))} />
										</div>
										<p class="tienda-detalle">
											{sucursales ? (
												<a href={sucursales} target="_blank" rel="noopener noreferrer">
													Sucursales en {ciudad.nombre.replace(/\s*\(.*\)/, '')}
												</a>
											) : (
												'Solo en línea, con envío a domicilio'
											)}
										</p>
									</li>
								);
							})}
						</ul>
					</section>

					<section class="formato" aria-labelledby="titulo-ebook">
						<div class="formato-encabezado">
							<h3 id="titulo-ebook">eBook</h3>
							<p>Se descarga al momento, sin envío ni sucursal.</p>
						</div>

						<ul class="tiendas papel contorno-mano">
							{ebooks.map(({ tienda, href }) => {
								const deSuCatalogo = esDeSuCatalogo(tienda, libro.editorial);
								return (
									<li class:list={['tienda', { destacada: deSuCatalogo }]}>
										<div class="tienda-nombre">
											<h4>{tienda.ebook.nombre ?? tienda.nombre}</h4>
											{deSuCatalogo && <p class="catalogo">{libro.editorial} es de su grupo editorial</p>}
										</div>
										<div class="tienda-acciones">
											<BotonTienda tienda={tienda} href={href} ebook />
										</div>
										<p class="tienda-detalle">{tienda.ebook.lectura}</p>
									</li>
								);
							})}
						</ul>
					</section>
				</section>
			</article>
		)
	}
</Layout>

<style>
	.volver {
		display: inline-block;
		margin: 1rem 0 1.5rem;
		font-weight: 700;
	}

	.vacio {
		display: grid;
		gap: 0.5rem;
	}

	.vacio h1 {
		font-size: var(--paso-3);
	}

	.cabecera {
		display: grid;
		grid-template-columns: minmax(10rem, 16rem) minmax(0, 1fr);
		gap: 2.5rem;
		align-items: start;
	}

	.ficha-libro {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
		justify-items: start;
	}

	h1 {
		font-size: var(--paso-4);
		font-weight: 800;
		letter-spacing: -0.02em;
		max-width: 20ch;
	}

	.subtitulo {
		font: italic var(--paso-1) / 1.35 var(--font-libro);
		color: var(--tinta-suave);
		max-width: 50ch;
	}

	.autor {
		font: italic 700 var(--paso-2) / 1.2 var(--font-libro);
		margin-bottom: 0.25rem;
	}

	.datos {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
		width: 100%;
		max-width: 40rem;
		margin: 0.75rem 0 0;
		border-top: 1px solid var(--renglon);
	}

	.datos div {
		padding: 0.5rem 0.75rem 0.5rem 0;
		border-bottom: 1px solid var(--renglon);
	}

	dt {
		color: var(--tinta-suave);
		font-size: var(--paso--1);
	}

	dd {
		margin: 0;
		font-weight: 700;
		overflow-wrap: anywhere;
	}

	.sinopsis {
		max-width: 66ch;
		margin-top: 3rem;
	}

	.texto {
		display: grid;
		gap: 0.9em;
		font: var(--paso-1) / 1.6 var(--font-libro);
	}

	.sinopsis .nota {
		margin-top: 0.75rem;
	}

	.sinopsis .aviso {
		margin-bottom: 1.25rem;
	}

	h2 {
		font-size: var(--paso-2);
		margin-bottom: 0.6rem;
	}

	.nota {
		color: var(--tinta-suave);
		font-size: var(--paso--1);
		margin-bottom: 0.5rem;
	}

	.compra {
		margin-top: 3.5rem;
	}

	.compra-encabezado {
		display: grid;
		gap: 0.3rem;
		margin-bottom: 1.25rem;
	}

	.tiendas {
		list-style: none;
		margin: 0;
		padding: 0;
		border-radius: 0.3rem;
	}

	.tienda {
		display: grid;
		grid-template-columns: minmax(12rem, 1fr) auto minmax(12rem, 15rem);
		align-items: center;
		gap: 0.75rem 1.5rem;
		padding: 1rem 1.25rem;
	}

	.tienda + .tienda {
		border-top: 1px solid var(--renglon);
	}

	.destacada {
		background: var(--papel-realce);
	}

	.formato + .formato {
		margin-top: 2.25rem;
	}

	.formato-encabezado {
		display: grid;
		gap: 0.2rem;
		margin-bottom: 0.75rem;
	}

	h3 {
		font-size: var(--paso-1);
	}

	h4 {
		font-size: var(--paso-1);
	}

	.tienda-nombre p {
		color: var(--tinta-suave);
		font-size: var(--paso--1);
	}

	.tienda-nombre .catalogo {
		color: var(--sello-verde);
		font-weight: 700;
	}

	.tienda-acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tienda-detalle {
		font-size: var(--paso--1);
		color: var(--tinta-suave);
	}

	.tienda-detalle a {
		color: var(--tinta);
		font-weight: 700;
	}

	@media (max-width: 52rem) {
		.tienda {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 40rem) {
		.cabecera {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}

		.cabecera :global(.portada-L) {
			width: 11rem;
		}

		.tienda-acciones :global(.boton-tienda) {
			flex: 1;
		}
	}
</style>
