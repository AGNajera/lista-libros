---
import DondeBuscamos from '../components/DondeBuscamos.astro';
import Estante from '../components/Estante.astro';
import Layout from '../layouts/Layout.astro';
import { CONSULTA_MINIMA } from '../lib/openlibrary';
import { PARAM_CIUDAD, ciudadElegida, nombreCompleto, obtenerUbicacion } from '../lib/ubicacion';

const { ciudad } = obtenerUbicacion(Astro.url, Astro.request);
const elegida = ciudadElegida(Astro.url);

/**
 * Clásicos mexicanos que se van escribiendo en el campo vacío, como ejemplos de qué buscar.
 * Si alguien empieza a escribir uno de estos títulos o autores, el campo lo completa.
 * El 15 de octubre de 2026, «El llano en llamas» estaba entre lo más leído de Gandhi y «Las batallas en el desierto»
 * entre lo más vendido de Planeta.
 */
const ejemplos = [
	{ titulo: 'Pedro Páramo', autor: 'Juan Rulfo' },
	{ titulo: 'Las batallas en el desierto', autor: 'José Emilio Pacheco' },
	{ titulo: 'El llano en llamas', autor: 'Juan Rulfo' },
	{ titulo: 'Como agua para chocolate', autor: 'Laura Esquivel' },
	{ titulo: 'Aura', autor: 'Carlos Fuentes' },
	{ titulo: 'El laberinto de la soledad', autor: 'Octavio Paz' },
	{ titulo: 'Los de abajo', autor: 'Mariano Azuela' },
	{ titulo: 'Balún Canán', autor: 'Rosario Castellanos' },
];
const rotulo = ({ titulo, autor }: (typeof ejemplos)[number]) => `${titulo}, ${autor}`;

// Le dice a Google cómo se llama el sitio para mostrarlo en los resultados.
const sitio = { '@type': 'WebSite', name: 'Librero', url: new URL('/', Astro.site ?? Astro.url).href, inLanguage: 'es-MX' };
---

<Layout datos={sitio}>
	<section class="busqueda">
		<h1>¿Dónde compro este libro?</h1>
		<form action="/buscar" method="get" role="search">
			{elegida && <input type="hidden" name={PARAM_CIUDAD} value={elegida.id} />}
			<label for="q">Escribe el título, el autor o el ISBN</label>
			<div class="fila">
				<div class="linea">
					{/* El placeholder va en blanco: solo sirve para que :placeholder-shown diga si el campo está vacío. */}
					<input id="q" name="q" type="search" required minlength={CONSULTA_MINIMA} autocomplete="off" aria-autocomplete="inline" placeholder=" " />
					{/* El ejemplo se dibuja encima del campo y los lectores de pantalla no lo leen mientras cambia. */}
					<span class="ejemplo" aria-hidden="true" data-ejemplos={JSON.stringify(ejemplos)}>{rotulo(ejemplos[0])}</span>
				</div>
				{/* El texto siempre está en el botón, aunque no se vea: es su nombre para los lectores de pantalla. */}
				<button class="boton" type="submit">
					<svg
						class="lupa"
						viewBox="0 0 24 24"
						width="24"
						height="24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.4"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<circle cx="10.5" cy="10.5" r="6.5"></circle>
						<path d="M15.4 15.4L20.5 20.5"></path>
					</svg>
					<span class="texto-boton">Buscar libro</span>
				</button>
			</div>
			{/* El texto que se completa llega seleccionado y no todos los lectores de pantalla lo leen: aquí se avisa. */}
			<p class="visualmente-oculto" role="status"></p>
			<p class="nota">
				Buscamos primero ediciones en español. Las tiendas físicas se buscan cerca de {nombreCompleto(ciudad)}.
			</p>
		</form>
	</section>

	<Estante server:defer ciudad={elegida?.id}>
		<Estante slot="fallback" esqueleto />
	</Estante>

	<DondeBuscamos />
</Layout>

<script>
	interface Ejemplo {
		titulo: string;
		autor: string;
	}

	const pausa = (ms: number) => new Promise((listo) => setTimeout(listo, ms));
	const rotulo = ({ titulo, autor }: Ejemplo) => `${titulo}, ${autor}`;
	/** Quitar acentos no cambia el largo de un texto en NFC, así que las posiciones siguen sirviendo para el original. */
	const sinAcentos = (texto: string) => texto.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();

	/**
	 * El último ejemplo que se vio escrito completo: es el primero que se ofrece al completar. Mientras uno se borra
	 * y el otro se escribe, sigue siendo el anterior.
	 */
	let ejemploActual = 0;

	/**
	 * Borra el ejemplo letra por letra y escribe el siguiente. Da una sola vuelta a la lista y se queda en el primero,
	 * para que nada se mueva sin fin en la página. En cuanto `quieto` dice que sí, se detiene para siempre.
	 */
	async function rotarEjemplos(ejemplo: HTMLElement, ejemplos: Ejemplo[], quieto: () => boolean) {
		const rotulos = ejemplos.map(rotulo);
		// Al detenerse deja completo el último ejemplo que se vio, por si el campo vuelve a quedar vacío y sin foco.
		const seguir = async (ms: number) => {
			await pausa(ms);
			if (!ejemplo.isConnected) return false;
			if (!quieto()) return true;
			ejemplo.textContent = rotulos[ejemploActual];
			return false;
		};
		for (let indice = 1; indice <= rotulos.length && rotulos.length > 1; indice++) {
			if (!(await seguir(2600))) return;
			const anterior = rotulos[indice - 1];
			const siguiente = rotulos[indice % rotulos.length];
			for (let n = anterior.length - 1; n >= 0; n--) {
				if (!(await seguir(28))) return;
				ejemplo.textContent = anterior.slice(0, n);
			}
			if (!(await seguir(350))) return;
			for (let n = 1; n <= siguiente.length; n++) {
				if (!(await seguir(60))) return;
				ejemplo.textContent = siguiente.slice(0, n);
			}
			ejemploActual = indice % rotulos.length;
		}
	}

	/**
	 * Mientras se escribe al final del campo, si lo escrito es el principio de un título o un autor de los ejemplos,
	 * el resto aparece seleccionado: seguir escribiendo lo reemplaza, borrar lo quita y Enter busca el texto completo.
	 * Lo escrito se cambia por el ejemplo tal cual, con sus mayúsculas y acentos.
	 * `aviso` dice la sugerencia a los lectores de pantalla y se vacía cuando deja de aplicar.
	 */
	function completarEjemplos(campo: HTMLInputElement, ejemplos: Ejemplo[], aviso: HTMLElement) {
		// Solo se toca si cambia, para no repetir la misma sugerencia en cada tecla.
		const avisar = (texto: string) => {
			if (aviso.textContent !== texto) aviso.textContent = texto;
		};

		/** El texto completo que se sugiere para lo escrito, si hay uno. */
		function sugerencia(evento: Event) {
			// Al borrar no se completa, para que la selección se pueda quitar.
			if (!(evento instanceof InputEvent) || evento.inputType !== 'insertText' || evento.isComposing) return;
			const escrito = campo.value;
			if (escrito.trim().length < 2 || campo.selectionEnd !== escrito.length) return;

			const buscado = sinAcentos(escrito);
			const { titulo, autor } = ejemplos[ejemploActual];
			const opciones = [titulo, autor, ...ejemplos.flatMap((ejemplo) => [ejemplo.titulo, ejemplo.autor])];
			return opciones.find((texto) => texto.length > escrito.length && sinAcentos(texto).startsWith(buscado));
		}

		campo.addEventListener('input', (evento) => {
			const escrito = campo.value;
			const opcion = sugerencia(evento);
			if (!opcion) {
				avisar('');
				return;
			}

			campo.value = opcion;
			campo.setSelectionRange(escrito.length, campo.value.length);
			avisar(`Sugerencia: ${opcion}`);
		});
	}

	/** Voltea un libro del estante a la contraportada o de regreso. */
	function voltear(libro: Element, volteado = !libro.hasAttribute('data-volteado')) {
		libro.toggleAttribute('data-volteado', volteado);
	}

	// El estante llega como server island después de que carga la página, así que los clics se escuchan en el documento.
	document.addEventListener('click', (evento) => {
		const objetivo = evento.target as Element;
		const libro = objetivo.closest('.estante .libro');
		if (!libro?.querySelector('.fuera')) return;

		// Sacar otro libro regresa el anterior al estante, ya con la portada al frente.
		if (objetivo.closest('.lomo')) {
			for (const otro of libro.parentElement!.querySelectorAll('.libro')) {
				otro.querySelector('.lomo')!.setAttribute('aria-expanded', String(otro === libro));
				voltear(otro, false);
			}
			libro.querySelector<HTMLButtonElement>('.flecha')!.focus({ preventScroll: true });
			libro.scrollIntoView({
				behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
				inline: 'nearest',
				block: 'nearest',
			});
		} else if (objetivo.closest('.tapa, .flecha')) {
			// Seleccionar texto de la sinopsis no cuenta como tocar el libro.
			if (objetivo.closest('.reves') && !getSelection()?.isCollapsed) return;
			voltear(libro);
		}
	});

	document.addEventListener('astro:page-load', () => {
		const ejemplo = document.querySelector<HTMLElement>('.busqueda .ejemplo');
		const campo = document.querySelector<HTMLInputElement>('.busqueda input[type="search"]');
		const aviso = document.querySelector<HTMLElement>('.busqueda [role="status"]');
		if (!ejemplo || !campo || !aviso) return;
		const ejemplos: Ejemplo[] = JSON.parse(ejemplo.dataset.ejemplos ?? '[]');
		ejemploActual = 0;
		completarEjemplos(campo, ejemplos, aviso);

		// Una vez que la persona llega al campo, el ejemplo ya no cambia: lo que se le ofrece es lo que vio.
		let tocado = document.activeElement === campo;
		campo.addEventListener('focus', () => (tocado = true), { once: true });
		// El foco se mira también directo: si la ventana no tiene el foco, enfocar el campo no dispara el evento.
		const quieto = () => tocado || document.activeElement === campo || campo.value !== '';
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) rotarEjemplos(ejemplo, ejemplos, quieto);
	});

	document.addEventListener('astro:before-swap', (evento) => {
		// Buscar desde la portada cambia de página sin animar; el buscador grande no tiene a dónde viajar.
		if (evento.from.pathname === '/' && evento.to.pathname === '/buscar') {
			evento.viewTransition.skipTransition();
		}
	});
</script>

<style>
	/* El buscador va centrado: la pregunta, la etiqueta y el campo con su botón sobre un mismo eje. */
	.busqueda {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
		gap: 1.75rem;
		padding-top: clamp(1rem, 4vw, 3rem);
		text-align: center;
	}

	h1 {
		font-size: var(--paso-3);
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	form {
		display: grid;
		justify-items: center;
		width: 100%;
		max-width: 44rem;
	}

	/* El texto del botón sale hacia la derecha, fuera del formulario: en pantallas medianas el formulario se angosta para que quepa. */
	@media (hover: hover) and (width > 34rem) {
		form {
			max-width: min(44rem, 100% - 16rem);
		}
	}

	label {
		display: block;
		font-style: italic;
		color: var(--tinta-suave);
	}

	/* El botón va a la derecha del campo, en el mismo renglón; en teléfono baja.
	   Su columna mide lo que la lupa, así que al desplegarse el texto el botón crece hacia la derecha y el campo no se mueve. */
	.fila {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 2.75rem;
		align-items: center;
		gap: 0.75rem 1rem;
		width: 100%;
		margin-top: 0.35rem;
	}

	.linea {
		position: relative;
		min-width: 0;
		border-bottom: 2px solid var(--tinta-suave);
		/* La letra es más chica que el título para que quepan el libro y su autor; en teléfono baja todavía más. */
		font: 700 clamp(1.05rem, 0.85rem + 0.9vw, 1.5rem) / 1.2 var(--font-libro);
	}

	.linea:focus-within {
		border-bottom-color: var(--rosa-texto);
		box-shadow: 0 2px 0 var(--rosa-texto);
	}

	input {
		width: 100%;
		padding: 0.3rem 0;
		border: 0;
		background: transparent;
		color: var(--tinta);
		font: inherit;
		text-align: center;
		appearance: none;
	}

	input:focus-visible {
		outline: none;
	}

	/* Se ve solo con el campo vacío y sin foco, en el mismo lugar donde iría el texto. */
	.ejemplo {
		position: absolute;
		inset: 0.3rem 0 0.3rem;
		overflow: hidden;
		color: var(--tinta-tenue);
		font-style: italic;
		font-weight: 400;
		white-space: nowrap;
		text-overflow: ellipsis;
		pointer-events: none;
	}

	input:not(:placeholder-shown) + .ejemplo,
	input:focus + .ejemplo {
		visibility: hidden;
	}

	/* Por defecto el botón es solo la lupa. El texto está en el botón con ancho cero. */
	.fila .boton {
		justify-self: start;
		gap: 0;
		min-width: 2.75rem;
		padding: 0 0.6rem;
	}

	.lupa {
		flex: none;
		width: 1.4rem;
		height: 1.4rem;
	}

	.texto-boton {
		max-width: 0;
		overflow: hidden;
		white-space: nowrap;
		opacity: 0;
		transition:
			max-width 0.35s cubic-bezier(0.3, 0.7, 0.2, 1),
			margin 0.35s cubic-bezier(0.3, 0.7, 0.2, 1),
			opacity 0.2s ease;
	}

	/* Con mouse, al pasar por el botón el texto se despliega. Con teclado, al enfocarlo. */
	@media (hover: hover) {
		.fila .boton:hover .texto-boton {
			max-width: 8rem;
			margin: 0 0.3rem 0 0.45rem;
			opacity: 1;
			transition-delay: 0s, 0s, 0.1s;
		}
	}

	.fila .boton:focus-visible .texto-boton {
		max-width: 8rem;
		margin: 0 0.3rem 0 0.45rem;
		opacity: 1;
	}

	.nota {
		margin-top: 1.25rem;
		font-size: var(--paso--1);
		color: var(--tinta-suave);
		text-wrap: balance;
	}

	/* En teléfono el botón va debajo del campo, con la lupa y el texto siempre a la vista. */
	@media (max-width: 34rem) {
		.fila {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.1rem;
		}

		.fila .boton {
			justify-self: center;
			padding-inline: 1.15rem;
		}

		.fila .texto-boton {
			max-width: none;
			margin: 0 0 0 0.45rem;
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.texto-boton {
			transition: none;
		}
	}
</style>
