---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SelectorUbicacion from '../components/SelectorUbicacion.astro';
import { conCiudad } from '../lib/ubicacion';
import '../styles/global.css';

interface Props {
	titulo?: string;
	descripcion?: string;
	/** Las páginas de resultados y los errores no deben aparecer en Google. */
	indexar?: boolean;
	/** Imagen para la vista previa al compartir el enlace (la portada del libro). */
	imagen?: string;
	tipo?: 'website' | 'book';
	/** Datos estructurados de schema.org que se insertan como JSON-LD. */
	datos?: Record<string, unknown>;
}

const {
	titulo,
	descripcion = 'Busca un libro y encuentra dónde comprarlo en México: Amazon, Gandhi, Planeta, Penguin, Sanborns, Sears y Liverpool.',
	indexar = true,
	imagen,
	tipo = 'website',
	datos,
} = Astro.props;
const conBuscador = Astro.slots.has('barra');
const tituloCompleto = titulo ? `${titulo} | Librero` : 'Librero: dónde comprar libros en México';
// La ciudad, la búsqueda y la edición viajan en la URL, pero la página es la misma: la canónica va sin parámetros.
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// «<» escapado para que un título con «</script>» no cierre la etiqueta.
const jsonLd = datos && JSON.stringify({ '@context': 'https://schema.org', ...datos }).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={descripcion} />
		<meta name="theme-color" content="#111b2e" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://covers.openlibrary.org" crossorigin />
		<title>{tituloCompleto}</title>
		{indexar ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex, follow" />}
		<meta property="og:site_name" content="Librero" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:type" content={tipo} />
		<meta property="og:title" content={titulo ?? tituloCompleto} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={canonica} />
		{imagen && <meta property="og:image" content={imagen} />}
		<meta name="twitter:card" content="summary" />
		{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
		{/* Se precargan los estilos que se ven al abrir: el texto, la negrita de los títulos y la cursiva de la ficha. */}
		<Font
			cssVariable="--font-libro"
			preload={[
				{ weight: 400, style: 'normal' },
				{ weight: 700, style: 'normal' },
				{ weight: 400, style: 'italic' },
			]}
		/>
		<ClientRouter />
	</head>
	<body>
		<div class="progreso" aria-hidden="true" transition:persist="progreso"></div>
		<a class="saltar" href="#contenido">Saltar al contenido</a>
		{/* Sin buscador en la barra (la portada trae el suyo), la marca va a un lado y la ciudad al otro. */}
		<header class:list={['barra', { 'sin-buscador': !conBuscador }]}>
			<a href={conCiudad('/', Astro.url)} class="marca" aria-label="Librero, ir al inicio" translate="no">Librero</a>
			{conBuscador && <div class="barra-busqueda"><slot name="barra" /></div>}
			<SelectorUbicacion />
		</header>
		<main id="contenido">
			<slot />
		</main>
		<footer class="pie">
			<p>
				Los datos de los libros vienen de <a href="https://openlibrary.org" rel="noopener">Open Library</a>. Cada
				tienda confirma precio, existencias y envío.
			</p>
		</footer>
	</body>
</html>

<script>
	function mostrarFallbackPortada(img: HTMLImageElement) {
		const fallback = img.parentElement?.querySelector<HTMLElement>('[data-sin-portada]');
		if (!fallback) return;
		img.hidden = true;
		fallback.hidden = false;
	}

	function revisarPortadas() {
		for (const img of document.querySelectorAll<HTMLImageElement>('img[data-portada-img]')) {
			if (img.complete && img.naturalWidth === 0) mostrarFallbackPortada(img);
		}
	}

	document.addEventListener(
		'error',
		(evento) => {
			const objetivo = evento.target;
			if (objetivo instanceof HTMLImageElement && objetivo.matches('[data-portada-img]')) {
				mostrarFallbackPortada(objetivo);
			}
		},
		true,
	);

	document.addEventListener('astro:before-preparation', () => {
		document.querySelector('.progreso')?.setAttribute('data-estado', 'cargando');
	});

	document.addEventListener('astro:after-swap', () => {
		const barra = document.querySelector('.progreso');
		if (!barra) return;
		barra.setAttribute('data-estado', 'listo');
		setTimeout(() => barra.removeAttribute('data-estado'), 250);
	});

	document.addEventListener('astro:page-load', () => {
		document.querySelector('.progreso')?.removeAttribute('data-estado');
		revisarPortadas();
	});
</script>

<style>
	.progreso {
		position: fixed;
		inset: 0 0 auto;
		z-index: 100;
		height: 3px;
		background: var(--rosa);
		transform: scaleX(0);
		transform-origin: left center;
		opacity: 0;
		pointer-events: none;
		transition:
			transform 0.35s ease-out,
			opacity 0.2s ease;
	}

	.progreso[data-estado='cargando'] {
		opacity: 1;
		transform: scaleX(0.72);
		transition: transform 2.5s cubic-bezier(0.1, 0.5, 0.2, 1);
	}

	.progreso[data-estado='listo'] {
		opacity: 0;
		transform: scaleX(1);
	}

	.saltar {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 110;
		padding: 0.5rem 0.9rem;
		border-radius: 0.35rem;
		background: var(--rosa);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
		transform: translateY(-200%);
	}

	.saltar:focus-visible {
		transform: translateY(0);
		color: #fff;
	}

	@media (prefers-reduced-motion: reduce) {
		.progreso {
			transition: none;
		}
	}
	.barra {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		width: 100%;
		max-width: var(--ancho);
		margin: 0 auto;
		padding: 1rem 1rem 0;
	}

	.sin-buscador {
		justify-content: space-between;
	}

	.marca {
		font: 800 var(--paso-2) / 1 var(--font-libro);
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.barra-busqueda {
		flex: 1 1 min(18rem, 100%);
		min-width: 0;
	}

	.pie {
		width: 100%;
		max-width: var(--ancho);
		margin: 0 auto;
		padding: 1.5rem 1rem 2.5rem;
		color: var(--tinta-suave);
		font-size: var(--paso--1);
	}
</style>
