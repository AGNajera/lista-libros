---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SelectorUbicacion from '../components/SelectorUbicacion.astro';
import { conCiudad } from '../lib/ubicacion';
import '../styles/global.css';

interface Props {
	titulo?: string;
	descripcion?: string;
	/** Las páginas de resultados y los errores no deben aparecer en Google. */
	indexar?: boolean;
	/** Imagen para la vista previa al compartir el enlace (la portada del libro). */
	imagen?: string;
	tipo?: 'website' | 'book';
	/** Datos estructurados de schema.org que se insertan como JSON-LD. */
	datos?: Record<string, unknown>;
}

const {
	titulo,
	descripcion = 'Busca un libro y encuentra dónde comprarlo en México: Amazon, Gandhi, Planeta, Penguin, Sanborns, Sears y Liverpool.',
	indexar = true,
	imagen,
	tipo = 'website',
	datos,
} = Astro.props;
const conBuscador = Astro.slots.has('barra');
const tituloCompleto = titulo ? `${titulo} | Librero` : 'Librero: dónde comprar libros en México';
// La ciudad, la búsqueda y la edición viajan en la URL, pero la página es la misma: la canónica va sin parámetros.
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// «<» escapado para que un título con «</script>» no cierre la etiqueta.
const jsonLd = datos && JSON.stringify({ '@context': 'https://schema.org', ...datos }).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={descripcion} />
		<meta name="theme-color" content="#111b2e" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{tituloCompleto}</title>
		{indexar ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex, follow" />}
		<meta property="og:site_name" content="Librero" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:type" content={tipo} />
		<meta property="og:title" content={titulo ?? tituloCompleto} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={canonica} />
		{imagen && <meta property="og:image" content={imagen} />}
		<meta name="twitter:card" content="summary" />
		{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
		{/* Se precargan los estilos que se ven al abrir: el texto, la negrita de los títulos y la cursiva de la ficha. */}
		<Font
			cssVariable="--font-libro"
			preload={[
				{ weight: 400, style: 'normal' },
				{ weight: 700, style: 'normal' },
				{ weight: 400, style: 'italic' },
			]}
		/>
		<ClientRouter />
	</head>
	<body>
		{/* Sin buscador en la barra (la portada trae el suyo), la marca va a un lado y la ciudad al otro. */}
		<header class:list={['barra', { 'sin-buscador': !conBuscador }]}>
			<a href={conCiudad('/', Astro.url)} class="marca" aria-label="Librero, ir al inicio">Librero</a>
			{conBuscador && <div class="barra-busqueda"><slot name="barra" /></div>}
			<SelectorUbicacion />
		</header>
		<main>
			<slot />
		</main>
		<footer class="pie">
			<p>
				Los datos de los libros vienen de <a href="https://openlibrary.org" rel="noopener">Open Library</a>. Cada
				tienda confirma precio, existencias y envío.
			</p>
		</footer>
	</body>
</html>

<style>
	.barra {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		width: 100%;
		max-width: var(--ancho);
		margin: 0 auto;
		padding: 1rem 1rem 0;
	}

	.sin-buscador {
		justify-content: space-between;
	}

	.marca {
		font: 800 var(--paso-2) / 1 var(--font-libro);
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.barra-busqueda {
		flex: 1 1 min(18rem, 100%);
		min-width: 0;
	}

	.pie {
		width: 100%;
		max-width: var(--ancho);
		margin: 0 auto;
		padding: 1.5rem 1rem 2.5rem;
		color: var(--tinta-suave);
		font-size: var(--paso--1);
	}
</style>
