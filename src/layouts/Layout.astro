---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SelectorUbicacion from '../components/SelectorUbicacion.astro';
import { conCiudad } from '../lib/ubicacion';
import '../styles/global.css';

interface Props {
	titulo?: string;
	descripcion?: string;
}

const {
	titulo,
	descripcion = 'Busca un libro y encuentra dónde comprarlo en México: Amazon, Gandhi, Planeta, Penguin, Sanborns, Sears y Liverpool.',
} = Astro.props;
const conBuscador = Astro.slots.has('barra');
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={descripcion} />
		<meta name="theme-color" content="#111b2e" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{titulo ? `${titulo} | Librero` : 'Librero: dónde comprar libros en México'}</title>
		{/* Se precargan los estilos que se ven al abrir: el texto, la negrita de los títulos y la cursiva de la ficha. */}
		<Font
			cssVariable="--font-libro"
			preload={[
				{ weight: 400, style: 'normal' },
				{ weight: 700, style: 'normal' },
				{ weight: 400, style: 'italic' },
			]}
		/>
		<ClientRouter />
	</head>
	<body>
		{/* Sin buscador en la barra (la portada trae el suyo), la marca va a un lado y la ciudad al otro. */}
		<header class:list={['barra', { 'sin-buscador': !conBuscador }]}>
			<a href={conCiudad('/', Astro.url)} class="marca" aria-label="Librero, ir al inicio">Librero</a>
			{conBuscador && <div class="barra-busqueda"><slot name="barra" /></div>}
			<SelectorUbicacion />
		</header>
		<main>
			<slot />
		</main>
		<footer class="pie">
			<p>
				Los datos de los libros vienen de <a href="https://openlibrary.org" rel="noopener">Open Library</a>. Cada
				tienda confirma precio, existencias y envío.
			</p>
		</footer>
	</body>
</html>

<style>
	.barra {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		width: 100%;
		max-width: var(--ancho);
		margin: 0 auto;
		padding: 1rem 1rem 0;
	}

	.sin-buscador {
		justify-content: space-between;
	}

	.marca {
		font: 800 var(--paso-2) / 1 var(--font-libro);
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.barra-busqueda {
		flex: 1 1 min(18rem, 100%);
		min-width: 0;
	}

	.pie {
		width: 100%;
		max-width: var(--ancho);
		margin: 0 auto;
		padding: 1.5rem 1rem 2.5rem;
		color: var(--tinta-suave);
		font-size: var(--paso--1);
	}
</style>
